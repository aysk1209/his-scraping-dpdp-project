# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/

# --- tooling caches ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- editors / OS ---
.idea/
.vscode/
.DS_Store

# --- secrets / credentials (never commit) ---
.env
/secrets/

# --- synthetic datasets are regenerable; keep them out of git ---
/data/
/src/data_synthetic/output/

# --- browser capture artifacts from Tier 2 work ---
*.har

# --- benchmark run artifacts: keep the directory + the headline result, not every run ---
/docs/benchmark_results/*
!/docs/benchmark_results/.gitkeep
!/docs/benchmark_results/README.md
!/docs/benchmark_results/benchmark.md
!/docs/benchmark_results/benchmark.json
!/docs/benchmark_results/benchmark-portal.json
# the public export's run (Synthea, public and synthetic): aggregate numbers only, safe to commit
!/docs/benchmark_results/benchmark-public.json
!/docs/benchmark_results/benchmark-public.md
!/docs/benchmark_results/weight-sweep.md
!/docs/benchmark_results/ablation.json
!/docs/benchmark_results/ablation.md
!/docs/benchmark_results/scale.json
!/docs/benchmark_results/scale.md
!/docs/benchmark_results/portal-trial-timing.json
!/docs/benchmark_results/injection.json
!/docs/benchmark_results/injection.md
!/docs/benchmark_results/care-pull--compliance-aware--purpose-matrix.md
!/docs/benchmark_results/billing-pull--compliance-aware--purpose-matrix.md
!/docs/benchmark_results/benchmark-portal.md
!/docs/benchmark_results/benchmark-portal-v2.json
!/docs/benchmark_results/benchmark-portal-v2.md
!/docs/benchmark_results/navigation-map.json
!/docs/benchmark_results/navigation-map.md
!/docs/benchmark_results/ui-update-check.md
!/docs/benchmark_results/techniques-compared.html
!/docs/benchmark_results/rules-vs-just-ai.html

# recorder quota ledger (per machine, per day)
.quota.json

# pseudonymisation keys written beside an export folder (interop.normalise)
*.keys/
