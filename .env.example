# Reference only -- nothing in the repository reads a .env file. Set these in your
# own shell for the session that needs them, and never paste a key into a chat
# or a commit. All demos and tests run with none of these set: the AI agents
# replay committed recordings.

# --- AI-agent comparison: needed only to RECORD (scripts/record_ai_agents.py) ---
# Whichever provider(s) you have; the script records every provider with a key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model ids default to each provider's current flagship. Free tiers may not have
# access to it -- run `record_ai_agents.py --list-models` and set the id you see.
AI_AGENT_MODEL_GEMINI=
AI_AGENT_MODEL_OPENAI=
AI_AGENT_MODEL_CLAUDE=

# --- Live HIS portal (build step 7, blocked) -- leave blank ---
# Passed on the command line when the time comes:
#   run_pipeline.py --portal URL --user U --password P --aliases FILE
HIS_PORTAL_URL=
HIS_PORTAL_USERNAME=
HIS_PORTAL_PASSWORD=
