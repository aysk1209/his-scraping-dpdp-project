# Copy this file to .env (which is gitignored) and fill in real values locally.
# Never commit .env or real credentials.

# Anthropic API key for the LLM extraction agent (build step 6).
ANTHROPIC_API_KEY=

# Live HIS portal credentials — leave blank. Live access is blocked (build step 7);
# all current work runs against synthetic data.
HIS_PORTAL_URL=
HIS_PORTAL_USERNAME=
HIS_PORTAL_PASSWORD=
